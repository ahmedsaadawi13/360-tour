# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=splash360_tour
DB_USER=root
DB_PASS=

# Application Configuration
APP_URL=http://localhost
# development | production (production hides PHP errors)
APP_ENV=development
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-me
APP_TIMEZONE=UTC

# Mail: "log" (writes storage/logs/mail.log) or "mail" (PHP mail())
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@splash360tour.com
MAIL_FROM_NAME="Splash360 Tour"

# Payment gateway: "dummy" approves all charges (development only)
PAYMENT_GATEWAY=dummy

# Max upload size in bytes (also raise upload_max_filesize/post_max_size in php.ini)
MAX_UPLOAD_SIZE=20971520

# Allow tenant webhooks to private/LAN addresses (e.g. self-hosted n8n). Off by default (SSRF protection).
WEBHOOK_ALLOW_PRIVATE=0
